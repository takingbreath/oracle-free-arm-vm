# Copy this file to config.env and change what you need.
# Every line is optional. The script finds the rest by itself.

# Which profile in ~/.oci/config to use.
OCI_PROFILE=DEFAULT

# Size of the VM. Always Free since 15 June 2026 = 2 OCPUs + 12 GB in total.
# A free account refuses more. A Pay As You Go account may pay for the part above 2/12.
OCPUS=2
MEMORY_GB=12

# Disk. Always Free = 200 GB in total for all boot and block volumes.
BOOT_VOLUME_GB=50

# Name of the VM in the Oracle console. The script stops if a VM with this name exists.
DISPLAY_NAME=free-a1

# The PUBLIC key that may log in as user 'ubuntu'.
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/oracle_a1.pub

# Seconds between tries. 60 is safe. Below 30 can get "TooManyRequests".
RETRY_SECONDS=60

# Stop after this many tries. 0 = never stop.
MAX_ATTEMPTS=0

# Only if you need them (empty = the script finds or makes them):
# COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
# SUBNET_ID=ocid1.subnet.oc1.xxxx
# IMAGE_ID=ocid1.image.oc1.xxxx
# UBUNTU_VERSION=24.04
# AVAILABILITY_DOMAINS="abcd:AP-MUMBAI-1-AD-1"
